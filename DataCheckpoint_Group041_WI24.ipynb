    "    if 'erhu' in str_ins:\n",
    "        str_ins=str_ins.replace('piano, erhu (chinese instrument)','piano, erhu')\n",
    "        output=str_ins\n",
    "    else:\n",
    "        output=str_ins\n",
    "    return output\n",
    "music_major_or['instrument_played']=music_major_or['instrument_played'].apply(standardize_ins)\n",
    "\n",
    "def standardize_com(str_com):\n",
